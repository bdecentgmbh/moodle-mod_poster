{{!
    @template mod_poster/content

    The block regions of a poster, side by side on wide screens.

    Context variables required for this template:
    * classes - Extra CSS classes of the poster content, e.g. for empty regions
    * editing - Whether the blocks are being edited
    * columns - The number of regions shown (1 or 2)
    * regions - The regions shown: suffix (pre or post), addblockbutton (HTML) and blocks (HTML)

    Optional context variables:
    * missingblockshelp - Help icon (HTML) explaining blocks that cannot be added here, while editing

    Example context (json):
    {
        "classes": "",
        "editing": false,
        "columns": 2,
        "regions": [
            {"suffix": "pre", "addblockbutton": "", "blocks": "<aside class=\"block-region\">Blocks</aside>"},
            {"suffix": "post", "addblockbutton": "", "blocks": "<aside class=\"block-region\">More blocks</aside>"}
        ],
        "missingblockshelp": ""
    }
}}
<div id="mod_poster-content" class="mod_poster-content {{#editing}}mod_poster-content-editing{{/editing}} {{classes}}">
    {{#missingblockshelp}}
        <p class="mod_poster-missingblocks small">{{#str}} missingblocks, mod_poster {{/str}} {{{missingblockshelp}}}</p>
    {{/missingblockshelp}}
    <div class="mod_poster-columns mod_poster-columns-{{columns}}">
        {{#regions}}
            <div class="mod_poster-content-region" id="mod_poster-content-region-{{suffix}}">
                {{{addblockbutton}}}
                {{{blocks}}}
            </div>
        {{/regions}}
    </div>
</div>
